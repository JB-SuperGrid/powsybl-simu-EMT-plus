    <extension id="G1">
        <subtransientMachineModel inertiaConstant="6.5" damping="0.0" statorResistance="0.0025"
                               directSynchronousReactance="1.8" quadratureSynchronousReactance="1.7"
                               directTransientReactance="0.3" openCircuitTransientTimeConstant="8.0"
                               statorLeakageReactance="0.2" quadratureTransientReactance="0.55"
                               directSubtransientReactance="0.25" quadratureSubtransientReactance="0.25"
                               quadratureOpenCircuitTransientTimeConstant="0.4"
                               directOpenCircuitSubtransientTimeConstant="0.03"
                               quadratureOpenCircuitSubtransientTimeConstant="0.05"
                               fieldCurrentAirGapLine="1000.0" numberOfPoles="2"
                               saturationFactor10="0.039175" saturationFactor12="0.222678"/>
        <simplifiedAvrModel enabled="true" gain="200.0" timeConstant="0.01" voltageSetpoint="20.6"
                            minOutput="-5.0" maxOutput="5.0"/>
        <pss1AModel enabled="true" gain="20.0" washoutTimeConstant="10.0" leadTimeConstant="0.05"
